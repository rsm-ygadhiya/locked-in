.DS_Store
._*
.Spotlight-V100
.Trashes

# build output
macos/.build/
*.o
*.dSYM/

# generated icon intermediates (rebuild with ./macos/build.sh --icon)
**/AppIcon.iconset/
icon_1024.png

# session recordings (written to the Desktop, but never commit one if it lands here)
LockedIn-Recordings/
*.mov
*.mkv
screen.mp4
camera.mp4
audio.wav

# a proctored session's working files: token.json is a live access token, and the
# live/ tiles are frames of somebody's screen
token.json
handoff.json
live/
*.jpg

# python
__pycache__/
*.pyc
.venv/

# the settings file, if anyone points LOCKEDIN_CONFIG at the repo — it holds password
# hashes, and every machine should generate its own
config.json
