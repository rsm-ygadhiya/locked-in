<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta charset="utf-8">
<title>Locked In</title>
<HTA:APPLICATION id="oHTA"
  applicationName="Locked In"
  border="none"
  caption="no"
  showInTaskbar="yes"
  singleInstance="yes"
  scroll="no"
  contextMenu="no"
  innerBorder="no"
  sysMenu="no"
  windowState="maximize" />
<style>
  * { margin:0; padding:0; }
  html, body { height:100%; width:100%; background:#000; overflow:hidden; font-family: Consolas, 'Courier New', monospace; }
  #matrix { position:absolute; top:0; left:0; }
  .veil { position:absolute; top:0; left:0; right:0; bottom:0; background: radial-gradient(circle at center, rgba(0,0,0,0.30), rgba(0,0,0,0.92)); }
  .wrap { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; }
  .badge { font-size:13px; letter-spacing:4px; color:#4ade80; text-transform:uppercase; margin-bottom:18px; }
  h1 { font-size:92px; color:#eafff0; text-shadow:0 0 18px rgba(74,222,128,.75), 0 0 42px rgba(34,197,94,.45); margin-bottom:6px; }
  .sub { font-size:20px; color:#9ffcbf; margin-bottom:36px; }
  .btn { display:inline-block; width:240px; vertical-align:top; margin:0 14px; padding:24px 18px; border-radius:16px;
         background:rgba(10,20,14,0.65); border:1px solid rgba(74,222,128,.35); cursor:pointer; }
  .btn:hover { border-color:#4ade80; box-shadow:0 0 28px rgba(74,222,128,.35); }
  .btn .ico { font-size:46px; color:#eafff0; }
  .btn .lbl { font-size:22px; color:#eafff0; margin-top:10px; }
  .btn .hint { font-size:12px; color:#7fe0a0; margin-top:6px; }
  .foot { position:absolute; bottom:20px; width:100%; text-align:center; color:#4ade80; font-size:12px; opacity:.6; }
  .overlay { position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.85); display:none; }
  .card { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:520px; background:#06120b;
          border:1px solid rgba(74,222,128,.4); border-radius:18px; padding:30px; color:#d7ffe6; text-align:left; }
  .card h2 { color:#4ade80; margin-bottom:12px; }
  .card p { line-height:1.6; margin-bottom:10px; font-size:14px; }
  .card code { background:rgba(74,222,128,.12); padding:2px 6px; border-radius:5px; color:#9ffcbf; }
  .close { margin-top:16px; padding:10px 20px; border-radius:10px; border:1px solid #4ade80; background:transparent; color:#eafff0; cursor:pointer; font-family:inherit; }
  .close:hover { background:rgba(74,222,128,.15); }
  .admin { position:absolute; top:16px; right:20px; cursor:pointer; font-size:13px; letter-spacing:1px;
           color:#7fe0a0; padding:8px 14px; border-radius:10px; border:1px solid rgba(74,222,128,.25); }
  .admin:hover { color:#eafff0; border-color:#4ade80; }
</style>
</head>
<body>
  <canvas id="matrix"></canvas>
  <div class="veil"></div>
  <div class="admin" onclick="openAdmin()">&#9881; Admin</div>

  <div class="wrap">
    <div class="badge">// study mode engaged</div>
    <h1>LOCKED IN &#128274;</h1>
    <div class="sub">yo. where we locking in today?</div>
    <div>
      <div class="btn" onclick="pick('macos')">
        <div class="ico"><svg viewBox="0 0 384 512" width="52" height="52" fill="#eafff0"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg></div>
        <div class="lbl">macOS</div>
        <div class="hint">how to run</div>
      </div>
      <div class="btn" onclick="pick('windows')">
        <div class="ico"><svg viewBox="0 0 448 512" width="50" height="50" fill="#eafff0"><path d="M0 93.7l183.6-25.3v177.4H0V93.7zm0 324.6l183.6 25.3V268.4H0v149.9zm203.8 28L448 480V268.4H203.8v177.9zm0-380.6v180.1H448V32L203.8 65.7z"/></svg></div>
        <div class="lbl">Windows</div>
        <div class="hint">run it now</div>
      </div>
    </div>
  </div>

  <div class="foot">no cap. only the assignment. touch grass later.</div>

  <div class="overlay" id="macOverlay">
    <div class="card">
      <h2>macOS setup &#8984;</h2>
      <p>This is the Windows launcher. It can't run the Mac version.</p>
      <p>On your Mac, open <code>Locked In.app</code> and click <b>macOS</b>.</p>
      <button class="close" onclick="hideMac()">bet, got it</button>
    </div>
  </div>

<script type="text/javascript">
  function pick(os) {
    if (os === 'macos') { document.getElementById('macOverlay').style.display = 'block'; return; }
    runWindows();
  }
  function hideMac() { document.getElementById('macOverlay').style.display = 'none'; }

  // The folder this .hta was launched from — everything else is found relative to it.
  function htaFolder() {
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    var htaPath = oHTA.commandLine;
    if (htaPath.charAt(0) === '"') { htaPath = htaPath.split('"')[1]; }
    else { htaPath = htaPath.split(' ')[0]; }
    return fso.GetParentFolderName(htaPath);
  }

  // In the repo the .py helpers sit one level up from windows/; a flattened copy on a
  // USB stick puts them right here.
  function findHelper(name) {
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    var folder = htaFolder();
    var here = folder + '\\' + name;
    if (fso.FileExists(here)) { return here; }
    var up = fso.GetParentFolderName(folder) + '\\' + name;
    if (fso.FileExists(up)) { return up; }
    return null;
  }

  function openAdmin() {
    try {
      var fso = new ActiveXObject('Scripting.FileSystemObject');
      var shell = new ActiveXObject('WScript.Shell');
      var panel = findHelper('admin_panel.py');
      if (!panel) {
        alert('admin_panel.py was not found. Keep it in this folder, or in the folder above it.');
        return;
      }
      // uv is preferred because it installs the script dependencies itself. Checking
      // the usual install paths first, then falling back to whatever is on PATH.
      var env = shell.Environment('PROCESS');
      var uvPaths = [env('LOCALAPPDATA') + '\\Programs\\uv\\uv.exe',
                     env('USERPROFILE') + '\\.local\\bin\\uv.exe'];
      var cmd = null;
      for (var i = 0; i < uvPaths.length; i++) {
        if (fso.FileExists(uvPaths[i])) {
          cmd = '"' + uvPaths[i] + '" run --script "' + panel + '"';
          break;
        }
      }
      if (!cmd) {
        // Try uv on PATH, then python; if both are missing the shell reports it.
        cmd = 'cmd /c uv run --script "' + panel + '" || python "' + panel + '" || '
            + 'echo Locked In needs Python. Install uv:  winget install --id=astral-sh.uv -e && pause';
      }
      shell.Run(cmd, 1, false);
    } catch (e) {
      alert('Could not open the admin panel: ' + e.message);
    }
  }

  function runWindows() {
    try {
      var shell = new ActiveXObject('WScript.Shell');
      var fso = new ActiveXObject('Scripting.FileSystemObject');
      var folder = htaFolder();
      var ps1 = folder + '\\guided-access.ps1';
      if (!fso.FileExists(ps1)) { alert('guided-access.ps1 was not found next to this app. Keep both files in the same folder.'); return; }
      shell.Run('powershell -NoProfile -ExecutionPolicy Bypass -File "' + ps1 + '"', 1, false);
      window.close();
    } catch (e) {
      alert('Could not launch the lockdown: ' + e.message);
    }
  }

  var canvas = document.getElementById('matrix');
  var ctx = canvas.getContext('2d');
  function resize() { canvas.width = document.body.clientWidth; canvas.height = document.body.clientHeight; }
  resize();
  window.onresize = resize;
  var glyphs = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ<>[]{}=+*/#$%&'.split('');
  var font = 16;
  var cols = Math.floor(canvas.width / font);
  var drops = [];
  for (var i = 0; i < cols; i++) { drops[i] = 1; }
  function draw() {
    ctx.fillStyle = 'rgba(0,0,0,0.08)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.font = font + 'px monospace';
    for (var j = 0; j < drops.length; j++) {
      var ch = glyphs[Math.floor(Math.random() * glyphs.length)];
      var x = j * font;
      var y = drops[j] * font;
      ctx.fillStyle = Math.random() > 0.975 ? '#eafff0' : '#22c55e';
      ctx.fillText(ch, x, y);
      if (y > canvas.height && Math.random() > 0.975) drops[j] = 0;
      drops[j]++;
    }
  }
  setInterval(draw, 45);
</script>
</body>
</html>
